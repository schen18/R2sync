<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Signature-level custom permissions for secure Hub IPC -->
    <permission
        android:name="${applicationId}.permission.ACCESS_R2_HUB"
        android:protectionLevel="signature"
        android:label="@string/perm_access_r2_hub_label"
        android:description="@string/perm_access_r2_hub_desc" />

    <permission
        android:name="${applicationId}.permission.WRITE_R2_HUB"
        android:protectionLevel="signature"
        android:label="@string/perm_write_r2_hub_label"
        android:description="@string/perm_write_r2_hub_desc" />

    <uses-permission android:name="${applicationId}.permission.ACCESS_R2_HUB" />
    <uses-permission android:name="${applicationId}.permission.WRITE_R2_HUB" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Storage Access Framework (SAF) DocumentsProvider for Cloudflare R2 Vault -->
        <provider
            android:name="com.dissonance.r2sync.provider.R2DocumentsProvider"
            android:authorities="${applicationId}.provider.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Secured Custom ContentProvider for companion app IPC & offline-first sync -->
        <provider
            android:name="com.dissonance.r2sync.provider.R2HubContentProvider"
            android:authorities="${applicationId}.provider.r2hub"
            android:exported="true"
            android:readPermission="${applicationId}.permission.ACCESS_R2_HUB"
            android:writePermission="${applicationId}.permission.WRITE_R2_HUB" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
